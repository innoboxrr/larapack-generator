{
    "models": [
        {
            "name": "Product",
            "props": [
                { "name": "title", "type": "string", "datatable": true },
                { "name": "price", "type": "decimal" },
                { "name": "stock", "type": "integer" },
                { "name": "active", "type": "boolean" },
                { "name": "notes", "type": "longText", "nullable": true },
                { "name": "category_id", "type": "foreignId", "constraint": "categories" }
            ],
            "load_relations": [
                { "type": "belongsTo", "related": "Category", "name": "category" }
            ],
            "endpoints": [
                { "name": "publish", "method": "post" },
                { "name": "restock", "method": "post", "target": "collection" },
                { "name": "preview", "method": "get", "uri": "{product_id}/preview", "public": true, "middleware": ["throttle:30,1"] },
                { "name": "moveTo", "method": "post", "uri": "{product_id}/move-to/{slot}" },
                { "name": "purge", "method": "delete", "target": "collection" }
            ]
        },
        {
            "name": "Category",
            "props": [
                { "name": "name", "type": "string", "datatable": true }
            ],
            "metas": true,
            "editable_metas": ["seo_title", "seo_og_image"],
            "protected_metas": ["views"],
            "load_relations": [
                { "type": "hasMany", "related": "Product", "name": "products" }
            ]
        },
        {
            "name": "AuditEntry",
            "immutable": true,
            "props": [
                { "name": "message", "type": "string", "datatable": true }
            ]
        },
        {
            "name": "ApiKey",
            "props": [
                { "name": "label", "type": "string", "datatable": true },
                { "name": "token_hash", "type": "string", "secret": true }
            ]
        },
        {
            "name": "Ledger",
            "routes": { "only": ["index", "show"] },
            "props": [
                { "name": "memo", "type": "string", "datatable": true }
            ]
        },
        {
            "name": "Ticket",
            "routes": { "only": ["index", "update", "bulkUpdate"] },
            "props": [
                { "name": "subject", "type": "string", "datatable": true }
            ]
        }
    ],
    "controllers": [
        {
            "name": "Desk",
            "endpoints": [
                { "name": "overview", "method": "get" },
                { "name": "summary", "method": "get", "ability": "shop.reports" },
                { "name": "webhook", "method": "post", "public": true, "middleware": ["throttle:60,1"] },
                { "name": "import", "method": "post", "uri": "import/{batch}", "ability": "shop.reports" },
                { "name": "mine", "method": "get", "authorize": "authenticated" }
            ]
        }
    ]
}
