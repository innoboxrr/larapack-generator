<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
>
    <php>
        <!--
            La suite no formatea lo que genera: las instantáneas y las pruebas
            comparan la salida de las plantillas, y Pint en cada generación la
            haría varias veces más lenta. Sin esto, desde 9.3.1 se usaría la
            Pint del generador. Las pruebas que formatean (y las de
            FormatsWithoutProjectPintTest) la cambian y la devuelven a `off`.
        -->
        <env name="LARAPACK_PINT" value="off" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="EndToEnd">
            <directory>tests/EndToEnd</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Stubs</directory>
        </exclude>
    </source>
</phpunit>
